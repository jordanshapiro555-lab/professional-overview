---
layout: base.njk
pagination:
  data: blogPostPages
  size: 1
  alias: post
permalink: "/blog/{{ post.slug }}/index.html"
eleventyComputed:
  title: "{{ post.seoTitle or post.title }} — Jordan Shapiro"
  description: "{{ post.metaDescription or post.summary }}"
---

<main>
  <nav class="breadcrumb-nav" aria-label="Breadcrumb">
    <ol class="breadcrumb-list">
      <li><a href="/CRO-Consulting/">Home</a></li>
      <li><a href="/CRO-Consulting/blog/">Blog</a></li>
      <li aria-current="page">{{ post.title }}</li>
    </ol>
  </nav>

  <article class="blog-post">
    <header class="post-header">
      {% if post.eyebrow %}<p class="post-eyebrow">{{ post.eyebrow }}</p>{% endif %}
      <h1>{{ post.title }}</h1>
      <div class="blog-meta">
        {% if post.authorName %}<span>{{ post.authorName }}</span>{% endif %}
        {% if post.authorName and (post.publishDate or post.readTime) %}<span class="blog-meta-divider" aria-hidden="true"></span>{% endif %}
        {% if post.publishDate %}<time datetime="{{ post.publishDate }}">{{ post.publishDate | fullDate }}</time>{% endif %}
        {% if post.publishDate and post.readTime %}<span class="blog-meta-divider" aria-hidden="true"></span>{% endif %}
        {% if post.readTime %}<span>{{ post.readTime }}</span>{% endif %}
      </div>
    </header>

    <div class="post-body">
      {{ post.body | richTextToHtml | safe }}
    </div>
  </article>
</main>
