# Set these with: supabase secrets set --env-file <private-env-file>
KLAVIYO_PRIVATE_API_KEY=replace-with-private-api-key
# Existing projects may instead keep the key in KLAVIYO_PRIVATE_KEY.
PII_HASH_PEPPER=replace-with-a-long-random-secret
# Existing projects may temporarily reuse EXIT_INTENT_WEBHOOK_SECRET.
ALLOWED_ORIGINS=https://your-exact-vercel-preview.vercel.app

